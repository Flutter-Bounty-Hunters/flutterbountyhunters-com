    <!-- Navbar -->
    <script type="text/javascript">
      (function() {
        const hero = document.querySelector("header");
        const navbar = document.getElementById("navbar");
        const toggle = document.getElementById("navbarToggle");
        const menu = document.getElementById("navbarMenu");
        const links = Array.from(menu.querySelectorAll("a"));

        // The navbar sticks at the moment that the hero above it leaves the window.
        new IntersectionObserver(([entry]) => {
          navbar.toggleAttribute("data-stuck", !entry.isIntersecting);
        }, { rootMargin: "-1px 0px 0px 0px" }).observe(hero);

        const target = document.getElementById("navbarTarget");
        let pointedAt = null;

        // Moves the target brackets to the link that's being pointed at, or else the link for the section in view.
        function aim() {
          const link = pointedAt || links.find((link) => link.hasAttribute("aria-current"));
          if (!link) {
            target.removeAttribute("data-locked");
            return;
          }

          // Appear directly on the first link, instead of sliding over from wherever the brackets were last seen.
          const isAppearing = !target.hasAttribute("data-locked");
          if (isAppearing) {
            target.style.transition = "none";
          }
          target.style.left = `${link.offsetLeft}px`;
          target.style.width = `${link.offsetWidth}px`;
          if (isAppearing) {
            target.getBoundingClientRect();
            target.style.transition = "";
          }
          target.toggleAttribute("data-locked", true);
        }

        function pointAt(link) {
          pointedAt = link;
          aim();
        }

        links.forEach((link) => {
          link.addEventListener("pointerenter", () => pointAt(link));
          link.addEventListener("pointerleave", () => pointAt(null));
          link.addEventListener("focus", () => link.matches(":focus-visible") && pointAt(link));
          link.addEventListener("blur", () => pointAt(null));
        });

        // Links change size when the web font loads.
        new ResizeObserver(aim).observe(menu);

        // Highlight the section that's crossing a line partway down the window.
        const sections = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            const link = links.find((link) => link.hash === "#" + entry.target.id);
            if (entry.isIntersecting) {
              link.setAttribute("aria-current", "true");
            } else {
              link.removeAttribute("aria-current");
            }
          });
          aim();
        }, { rootMargin: "-40% 0px -60% 0px" });
        links.forEach((link) => sections.observe(document.querySelector(link.hash)));

        function setOpen(isOpen) {
          navbar.toggleAttribute("data-open", isOpen);
          toggle.setAttribute("aria-expanded", isOpen);
        }

        toggle.addEventListener("click", () => {
          const isOpen = !navbar.hasAttribute("data-open");
          setOpen(isOpen);

          // Below the hero, the navbar is near the bottom of the window. Bring it to the top to make room for the menu.
          if (isOpen && !navbar.hasAttribute("data-stuck")) {
            window.scrollTo({ top: hero.offsetTop + hero.offsetHeight });
          }
        });

        links.forEach((link) => link.addEventListener("click", () => setOpen(false)));

        document.addEventListener("click", (e) => {
          if (!navbar.contains(e.target)) {
            setOpen(false);
          }
        });

        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && navbar.hasAttribute("data-open")) {
            setOpen(false);
            toggle.focus();
          }
        });
      })();
    </script>

    <!-- Scope projector beam -->
    <script type="text/javascript">
      (function() {
        const canvas = document.getElementById("scopeBeam");
        const hunter = document.getElementById("bountyHunter");
        const hologram = document.getElementById("hologram");
        const ctx = canvas.getContext("2d");

        // Where the scope's front lens sits within the character image.
        const LENS_X = 0.555;
        const LENS_Y = 0.6255;

        // Where the hologram's corner brackets sit within the hologram image.
        const FRAME = { left: 0.026, top: 0.193, right: 0.974, bottom: 0.8 };

        // Drawing at a reduced resolution softens the light, and is cheaper.
        const SCALE = 0.5;

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        function random(seed) {
          const x = Math.sin(seed * 127.1) * 43758.5453;
          return x - Math.floor(x);
        }

        const rays = Array.from({ length: 26 }, (_, i) => ({
          position: (i + random(i + 1)) / 26,
          width: 0.012 + 0.05 * random(i + 50),
          strength: 0.25 + 0.75 * random(i + 100),
          speed: 0.3 + 0.9 * random(i + 150),
        }));

        const motes = Array.from({ length: 70 }, (_, i) => ({
          distance: random(i + 200),
          position: random(i + 300),
          size: 0.35 + 0.6 * random(i + 400),
          speed: 0.004 + 0.012 * random(i + 500),
          phase: 6.28 * random(i + 600),
        }));

        // Brightness of the projector's lamp, which flickers lightly, and stutters every few seconds.
        function lampBrightness(time) {
          const hum = 0.95 + 0.03 * Math.sin(time * 7.3) + 0.02 * Math.sin(time * 23.1);
          const step = Math.floor(time * 18);
          const grain = 0.05 * random(step);

          const cycle = Math.floor(time / 3.1);
          const sinceStutter = time - cycle * 3.1 - 2.2 * random(cycle + 700);
          const isStuttering = sinceStutter > 0 && sinceStutter < 0.28;
          const stutter = isStuttering ? 0.2 * random(step + 900) : 0;

          return hum - grain - stutter;
        }

        function draw(time) {
          const flicker = reducedMotion.matches ? 0.95 : lampBrightness(time);
          hologram.style.opacity = flicker;

          const bounds = canvas.getBoundingClientRect();
          const width = Math.round(bounds.width * SCALE);
          const height = Math.round(bounds.height * SCALE);
          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
          }
          ctx.setTransform(SCALE, 0, 0, SCALE, 0, 0);
          ctx.clearRect(0, 0, bounds.width, bounds.height);
          ctx.globalCompositeOperation = "lighter";

          const h = hunter.getBoundingClientRect();
          const lens = { x: h.left - bounds.left + h.width * LENS_X, y: h.top - bounds.top + h.height * LENS_Y };

          const p = hologram.getBoundingClientRect();
          if (h.width === 0 || p.width === 0) {
            return;
          }
          const left = p.left - bounds.left + p.width * FRAME.left;
          const right = p.left - bounds.left + p.width * FRAME.right;
          const top = p.top - bounds.top + p.height * FRAME.top;
          const bottom = p.top - bounds.top + p.height * FRAME.bottom;

          // The beam spans the widest angle that the hologram's frame covers, as seen from the lens.
          const corners = [[left, top], [right, top], [right, bottom], [left, bottom]].map(([x, y]) => ({
            x, y, angle: Math.atan2(y - lens.y, x - lens.x), distance: Math.hypot(x - lens.x, y - lens.y),
          })).sort((a, b) => a.angle - b.angle);
          const first = corners[0];
          const last = corners[3];
          const reach = Math.max(...corners.map((c) => c.distance));
          const near = Math.min(...corners.map((c) => c.distance)) / reach;

          const light = (alpha) => {
            const g = ctx.createRadialGradient(lens.x, lens.y, 0, lens.x, lens.y, reach);
            g.addColorStop(0, `rgba(150, 225, 255, ${alpha})`);
            g.addColorStop(near * 0.25, `rgba(70, 180, 255, ${alpha * 0.55})`);
            g.addColorStop(near, `rgba(40, 150, 255, ${alpha * 0.26})`);
            g.addColorStop(1, `rgba(30, 130, 255, ${alpha * 0.07})`);
            return g;
          };

          // Everything in the beam stays within the silhouette from the lens around the hologram's frame.
          ctx.save();
          ctx.beginPath();
          ctx.moveTo(lens.x, lens.y);
          ctx.lineTo(first.x, first.y);
          [[left, top], [right, top], [right, bottom], [left, bottom]]
            .map(([x, y]) => ({ x, y, a: Math.atan2(y - lens.y, x - lens.x), d: Math.hypot(x - lens.x, y - lens.y) }))
            .filter((c) => c.a > first.angle && c.a < last.angle && c.d > Math.min(first.distance, last.distance))
            .sort((a, b) => a.a - b.a)
            .slice(0, 1)
            .forEach((c) => ctx.lineTo(c.x, c.y));
          ctx.lineTo(last.x, last.y);
          ctx.closePath();
          ctx.clip();

          ctx.fillStyle = light(0.42 * flicker);
          ctx.fillRect(0, 0, bounds.width, bounds.height);

          const spread = last.angle - first.angle;
          rays.forEach((ray, i) => {
            const angle = first.angle + spread * (ray.position + 0.012 * Math.sin(time * ray.speed + i));
            const half = spread * ray.width / 2;
            ctx.fillStyle = light(0.30 * ray.strength * flicker * (0.75 + 0.25 * Math.sin(time * ray.speed * 2 + i * 1.7)));
            ctx.beginPath();
            ctx.moveTo(lens.x, lens.y);
            ctx.lineTo(lens.x + Math.cos(angle - half) * reach, lens.y + Math.sin(angle - half) * reach);
            ctx.lineTo(lens.x + Math.cos(angle + half) * reach, lens.y + Math.sin(angle + half) * reach);
            ctx.fill();
          });

          motes.forEach((mote) => {
            const d = ((mote.distance + time * mote.speed) % 1) * reach * 0.9;
            const a = first.angle + spread * (mote.position + 0.02 * Math.sin(time * 0.4 + mote.phase));
            const alpha = 0.5 * (0.5 + 0.5 * Math.sin(time * 1.3 + mote.phase)) * (1 - d / reach);
            ctx.fillStyle = `rgba(190, 235, 255, ${alpha})`;
            ctx.beginPath();
            ctx.arc(lens.x + Math.cos(a) * d, lens.y + Math.sin(a) * d, mote.size + 0.6, 0, 6.2832);
            ctx.fill();
          });
          ctx.restore();

          // The lit lens, and the light it spills across the rifle.
          const glow = (radius, stops) => {
            const g = ctx.createRadialGradient(lens.x, lens.y, 0, lens.x, lens.y, radius);
            stops.forEach(([at, color]) => g.addColorStop(at, color));
            ctx.fillStyle = g;
            ctx.fillRect(lens.x - radius, lens.y - radius, radius * 2, radius * 2);
          };
          const size = h.width / 500;
          glow(90 * size, [[0, `rgba(50, 160, 255, ${0.55 * flicker})`], [0.35, `rgba(35, 130, 255, ${0.16 * flicker})`], [1, "rgba(20, 100, 255, 0)"]]);
          glow(15 * size, [[0, "rgba(255, 255, 255, 1)"], [0.3, "rgba(190, 240, 255, 0.95)"], [0.6, "rgba(60, 180, 255, 0.45)"], [1, "rgba(40, 150, 255, 0)"]]);
        }

        let isVisible = true;
        let frame = null;

        function tick(now) {
          frame = null;
          draw(now / 1000);
          if (isVisible && !reducedMotion.matches) {
            frame = requestAnimationFrame(tick);
          }
        }

        function schedule() {
          if (frame === null) {
            frame = requestAnimationFrame(tick);
          }
        }

        new IntersectionObserver((entries) => {
          isVisible = entries[entries.length - 1].isIntersecting;
          schedule();
        }).observe(canvas);
        reducedMotion.addEventListener("change", schedule);
        window.addEventListener("resize", schedule);
        window.addEventListener("load", schedule);
        schedule();
      })();
    </script>

    <!-- Beams from the bounty hunter's neck lights, which project the funders' logos -->
    <script type="text/javascript">
      (function() {
        const section = document.getElementById("OurFunders");
        const hunter = document.getElementById("fundersHunter");
        const funders = Array.from(section.querySelectorAll(".funder"));

        // Most of the light passes behind the hunter, and some passes in front.
        const back = document.getElementById("fundersBeams");
        const front = document.getElementById("fundersBeamsInFront");
        const ctx = back.getContext("2d");
        const frontCtx = front.getContext("2d");
        const FRONT_LIGHT = 0.4;

        // Drawing at a reduced resolution softens the light, and is cheaper.
        const SCALE = 0.5;

        // Where the neck lights sit within the hunter image.
        const LAMPS = [{ x: 0.4175, y: 0.3889 }, { x: 0.5831, y: 0.3889 }];

        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        function random(seed) {
          const x = Math.sin(seed * 127.1) * 43758.5453;
          return x - Math.floor(x);
        }

        // Eases from 0 to 1 as x goes from start to end.
        function smoothstep(start, end, x) {
          const t = Math.min(1, Math.max(0, (x - start) / (end - start)));
          return t * t * (3 - 2 * t);
        }

        function bell(x) {
          return Math.exp(-x * x);
        }

        // Each lamp's light is first drawn here, by itself, and then added to the scene.
        const lampLight = document.createElement("canvas");
        const lampCtx = lampLight.getContext("2d");

        // The light's color, and how it dies out over its reach. It eases to nothing, so that there's no visible end.
        const LIGHT = [
          [0, "190, 238, 255", 1],
          [0.1, "115, 208, 255", 0.68],
          [0.22, "75, 180, 255", 0.5],
          [0.36, "55, 165, 255", 0.38],
          [0.5, "45, 155, 255", 0.27],
          [0.62, "42, 152, 255", 0.175],
          [0.74, "40, 150, 255", 0.095],
          [0.85, "40, 150, 255", 0.038],
          [0.94, "40, 150, 255", 0.009],
          [1, "40, 150, 255", 0],
        ];

        // Draws the light from a lamp, where the given brightness varies by angle, and fades over the given reach.
        function drawLight({ lamp, from, to, reach, brightness, width, height }) {
          const steps = 240;
          const byAngle = lampCtx.createConicGradient(from, lamp.x, lamp.y);
          for (let i = 0; i <= steps; i += 1) {
            const angle = from + (to - from) * i / steps;
            byAngle.addColorStop((angle - from) / (2 * Math.PI), `rgba(255, 255, 255, ${Math.min(1, brightness(angle))})`);
          }
          byAngle.addColorStop(1, "rgba(255, 255, 255, 0)");

          const byDistance = lampCtx.createRadialGradient(lamp.x, lamp.y, 0, lamp.x, lamp.y, reach);
          LIGHT.forEach(([at, color, alpha]) => byDistance.addColorStop(at, `rgba(${color}, ${alpha})`));

          lampCtx.globalCompositeOperation = "copy";
          lampCtx.fillStyle = byAngle;
          lampCtx.fillRect(0, 0, width, height);
          lampCtx.globalCompositeOperation = "source-in";
          lampCtx.fillStyle = byDistance;
          lampCtx.fillRect(0, 0, width, height);

          ctx.drawImage(lampLight, 0, 0, width, height);
        }

        function draw(time) {
          const bounds = back.getBoundingClientRect();
          const h = hunter.getBoundingClientRect();
          const width = Math.round(bounds.width);
          const height = Math.round(bounds.height);
          if (width === 0 || height === 0 || h.width === 0) {
            return;
          }
          const pixelWidth = Math.round(width * SCALE);
          const pixelHeight = Math.round(height * SCALE);
          [back, front, lampLight].forEach((canvas) => {
            if (canvas.width !== pixelWidth || canvas.height !== pixelHeight) {
              canvas.width = pixelWidth;
              canvas.height = pixelHeight;
            }
            canvas.getContext("2d").setTransform(SCALE, 0, 0, SCALE, 0, 0);
          });

          ctx.clearRect(0, 0, width, height);
          ctx.globalCompositeOperation = "lighter";

          const flicker = reducedMotion.matches ? 0.95 : 0.95 + 0.03 * Math.sin(time * 7.3) + 0.02 * Math.sin(time * 23);
          const lamps = LAMPS.map((lamp) => ({ x: h.left - bounds.left + h.width * lamp.x, y: h.top - bounds.top + h.height * lamp.y }));
          const dustSize = Math.min(1, Math.max(0.5, h.width / 823));
          const middle = (lamps[0].x + lamps[1].x) / 2;

          const logos = funders.map((funder) => {
            const rect = funder.querySelector(".funder-logo").getBoundingClientRect();
            return {
              x: rect.left - bounds.left + rect.width / 2,
              y: rect.top - bounds.top + rect.height / 2,
              radius: rect.height * 0.67,
              isPointedAt: funder.matches(":hover, :focus-visible"),
            };
          });

          lamps.forEach((lamp, side) => {
            // Each light projects the logos on its own side. Both lights project a logo in the middle.
            const direction = side === 0 ? -1 : 1;
            const targets = logos
              .map((logo) => ({ ...logo, offset: (logo.x - middle) * direction }))
              .filter((logo) => logo.offset > -logo.radius / 2)
              .map((logo) => ({
                ...logo,
                isShared: logo.offset < logo.radius / 2,
                angle: Math.atan2(logo.y - lamp.y, logo.x - lamp.x),
                distance: Math.hypot(logo.x - lamp.x, logo.y - lamp.y),
              }));
            if (targets.length === 0) {
              return;
            }

            // The light fades out gradually to either side of the logos, most of all toward the outside.
            const first = Math.min(...targets.map((logo) => logo.angle));
            const last = Math.max(...targets.map((logo) => logo.angle));
            const outside = 0.55;
            const inside = 0.16;
            const from = first - (side === 0 ? outside : inside);
            const to = last + (side === 0 ? inside : outside);
            const edges = (angle) => smoothstep(from, first + 0.04, angle) * (1 - smoothstep(last - 0.04, to, angle));

            const rays = Array.from({ length: 34 }, (_, i) => {
              const seed = i + 1 + side * 60;
              const sway = 0.008 * Math.sin(time * (0.3 + random(i)) + i);
              return {
                angle: from + (to - from) * ((i + random(seed)) / 34 + sway),
                width: 0.006 + 0.016 * random(seed + 50),
                strength: 0.06 + 0.24 * random(seed + 90),
              };
            });

            const brightness = (angle) => {
              const beams = targets.reduce((sum, logo) => {
                const half = Math.asin(Math.min(1, logo.radius / logo.distance));
                const strength = logo.isShared ? 0.315 : 0.42;
                return sum + strength * bell((angle - logo.angle) / (half * 0.85));
              }, 0);
              const streaks = rays.reduce((sum, ray) => sum + ray.strength * bell((angle - ray.angle) / ray.width), 0);
              return (edges(angle) * (0.56 + streaks) + smoothstep(0, 1, edges(angle) * 2) * beams) * flicker;
            };

            const reach = Math.max(...targets.map((logo) => logo.distance)) * 1.55;
            drawLight({ lamp, from, to, reach, brightness, width, height });

            // Dust that drifts through the light.
            ctx.fillStyle = "rgb(205, 242, 255)";
            for (let i = 0; i < 70; i += 1) {
              const seed = i + side * 60;
              const distance = (random(seed + 200) + time * (0.004 + 0.012 * random(i + 500))) % 1;
              const angle = from + (to - from) * random(seed + 300);
              const twinkle = 0.5 + 0.5 * Math.sin(time + 6 * random(i));
              ctx.globalAlpha = 0.6 * (1 - distance) * (1 - distance) * edges(angle) * twinkle;
              ctx.beginPath();
              ctx.arc(lamp.x + reach * distance * Math.cos(angle), lamp.y + reach * distance * Math.sin(angle), dustSize * (1.1 + random(i + 400) * 1.2), 0, 6.2832);
              ctx.fill();
            }
            ctx.globalAlpha = 1;
          });

          // Both lights turn up their beams on a logo that's pointed at.
          logos.filter((logo) => logo.isPointedAt).forEach((logo) => lamps.forEach((lamp) => {
            const angle = Math.atan2(logo.y - lamp.y, logo.x - lamp.x);
            const distance = Math.hypot(logo.x - lamp.x, logo.y - lamp.y);
            const half = Math.asin(Math.min(1, logo.radius / distance)) * 0.85;
            drawLight({
              lamp,
              from: angle - half * 3,
              to: angle + half * 3,
              reach: distance * 1.7,
              brightness: (a) => 0.4 * bell((a - angle) / half) * flicker,
              width,
              height,
            });
          }));

          frontCtx.clearRect(0, 0, width, height);
          frontCtx.globalCompositeOperation = "lighter";
          frontCtx.globalAlpha = FRONT_LIGHT;
          frontCtx.drawImage(back, 0, 0, width, height);
          frontCtx.globalAlpha = 1;

          // The lit lamps.
          const radius = h.width * 0.141;
          lamps.forEach((lamp) => {
            const glow = frontCtx.createRadialGradient(lamp.x, lamp.y, 0, lamp.x, lamp.y, radius);
            glow.addColorStop(0, `rgba(255, 255, 255, ${flicker})`);
            glow.addColorStop(0.1, `rgba(190, 240, 255, ${0.9 * flicker})`);
            glow.addColorStop(0.26, `rgba(60, 165, 255, ${0.4 * flicker})`);
            glow.addColorStop(1, "rgba(40, 150, 255, 0)");
            frontCtx.fillStyle = glow;
            frontCtx.fillRect(lamp.x - radius, lamp.y - radius, radius * 2, radius * 2);
          });
        }

        let isVisible = false;
        let frame = null;

        function tick(now) {
          frame = null;
          draw(now / 1000);
          if (isVisible && !reducedMotion.matches) {
            frame = requestAnimationFrame(tick);
          }
        }

        function schedule() {
          if (frame === null) {
            frame = requestAnimationFrame(tick);
          }
        }

        new IntersectionObserver((entries) => {
          isVisible = entries[entries.length - 1].isIntersecting;
          schedule();
        }).observe(section);
        funders.forEach((funder) => ["pointerenter", "pointerleave", "focus", "blur"].forEach((type) => funder.addEventListener(type, schedule)));
        reducedMotion.addEventListener("change", schedule);
        window.addEventListener("resize", schedule);
        window.addEventListener("load", schedule);
      })();
    </script>

    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
    <script type="text/javascript">
      (function(){
         emailjs.init({
           publicKey: "fOv5J8j1CnmUDzs_1",
           limitRate: {
            // Set the limit rate for the application
            id: 'app',
            // Allow 1 request per 10s
            throttle: 10000,
          },
         });
      })();

      (function() {
        const form = document.getElementById("workForm");
        const status = document.getElementById("workStatus");
        const send = form.querySelector(".work-send");
        const { message, name, email } = form.elements;
        const needBoxes = Array.from(form.querySelectorAll("[name=need]"));

        const PROMPTS = {
          "Package": "We need a package that…",
          "Bug fix": "This Flutter bug is upsetting our customers…",
          "Feature": "We need Flutter to…",
        };

        function checkedNeeds() {
          return needBoxes.filter((box) => box.checked).map((box) => box.value);
        }

        // Prompts for a message about whatever is checked.
        function updatePrompt() {
          const needs = checkedNeeds();
          if (needs.length === 0) {
            message.placeholder = "What does your app need?";
          } else if (needs.length === 1) {
            message.placeholder = PROMPTS[needs[0]];
          } else {
            const names = needs.map((need) => need.toLowerCase());
            message.placeholder = `Tell us about the ${names.slice(0, -1).join(", ")} and ${names[names.length - 1]} you need…`;
          }
        }

        function showStatus(text, isError) {
          status.textContent = text;
          status.toggleAttribute("data-error", isError);
        }

        function setInvalid(fields, isInvalid) {
          fields.forEach((field) => {
            if (isInvalid) {
              field.setAttribute("aria-invalid", "true");
            } else {
              field.removeAttribute("aria-invalid");
            }
          });
        }

        // Returns the first problem with the form, and marks every field that has one.
        function validate() {
          const checks = [
            { fields: [name], isInvalid: name.value.trim() === "", text: "Enter your name." },
            { fields: [email], isInvalid: email.value.trim() === "" || !email.validity.valid, text: "Enter a valid email address." },
            { fields: [message], isInvalid: message.value.trim() === "", text: "Tell us what you need." },
            { fields: needBoxes, isInvalid: checkedNeeds().length === 0, text: "Select at least one: package, bug fix, or feature." },
          ];
          checks.forEach(({ fields, isInvalid }) => setInvalid(fields, isInvalid));
          return checks.find(({ isInvalid }) => isInvalid);
        }

        form.addEventListener("change", updatePrompt);

        form.addEventListener("input", (e) => {
          setInvalid(needBoxes.includes(e.target) ? needBoxes : [e.target], false);
          showStatus("", false);
        });

        form.addEventListener("submit", (e) => {
          e.preventDefault();

          const problem = validate();
          if (problem) {
            showStatus(problem.text, true);
            problem.fields[0].focus();
            return;
          }

          send.disabled = true;
          showStatus("Sending…", false);

          emailjs.send("service_vcpx8t4", "template_fbh", {
            "reply_to": email.value.trim(),
            "from_name": name.value.trim(),
            "message": `Needs: ${checkedNeeds().join(", ")}\n\n${message.value.trim()}`,
          }).then(() => {
            form.reset();
            updatePrompt();
            showStatus("Thanks. We got your message, and we'll reply by email.", false);
          }).catch(() => {
            showStatus("Your message didn't send. Try again, or reach Matt on X at @SuprDeclarative.", true);
          }).finally(() => {
            send.disabled = false;
          });
        });

        // Browsers can restore checked boxes when returning to the page.
        updatePrompt();
      })();
    </script>
