            <symbol id="se-mention" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M16 12v1.5a2.5 2.5 0 0 0 5 0V12a9 9 0 1 0-4 7.5"/></symbol>
            <symbol id="se-send" viewBox="0 0 24 24"><path d="M4 12l16-8-6 17-3-7z"/></symbol>
            <symbol id="se-hash" viewBox="0 0 24 24"><path d="M5 9h14M5 15h14M10 4L8 20M16 4l-2 16"/></symbol>
            <symbol id="se-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5"/></symbol>
            <symbol id="se-menu" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10"/></symbol>
            <symbol id="se-left" viewBox="0 0 24 24"><path d="M4 6h16M4 12h10M4 18h14"/></symbol>
            <symbol id="se-center" viewBox="0 0 24 24"><path d="M4 6h16M7 12h10M5 18h14"/></symbol>
