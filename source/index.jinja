<!--
title: Flutter Bounty Hunters
description: Professional open source Flutter and Dart development
base_url: https://flutterbountyhunters.com
-->
<!doctype html>

<html lang="en">
  <head>
    <meta charset="utf-8">
    <title>{{  title  }}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="apple-touch-icon" sizes="180x180" href="/images/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon/favicon-16x16.png">
    <link rel="manifest" href="/images/favicon/site.webmanifest">
    <link rel="mask-icon" href="/images/favicon/safari-pinned-tab.svg" color="#5bbad5">
    <link rel="shortcut icon" href="/images/favicon/favicon.ico">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="msapplication-config" content="/images/favicon/browserconfig.xml">
    <meta name="theme-color" content="#ffffff">

    <!-- Open Graph Social Media -->
    <meta property="og:url" content="{{ homepage_url }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:image" content="{{ homepage_url }}/images/social.png" />
    <meta property="og:type" content="website" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@FlutterBounties" />
    <meta name="twitter:url" content="{{ homepage_url }}" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="{{ homepage_url }}/images/social.png" />

    <!-- Tailwind CSS -->
    <link href="/styles/tailwind.css" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bowlby+One&family=Geist:ital,wght@0,400..700;1,400&family=Geist+Mono:wght@400&family=Oxanium:wght@600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="relative w-screen text-white font-[-apple-system, BlinkMacSystemFont, sans-serif] bg-[#0a0807]">
    <!-- Start of content -->
    <header class="relative overflow-hidden min-h-[clamp(600px,88svh,1080px)] bg-[#080B14]">
      <!-- Moonlit desert, painted at 2335x1080 with the skyline 60% of the way up -->
      <img src="/images/hero/desert-night.webp" width="2335" height="1080" alt="" class="absolute inset-0 w-full h-full max-w-none object-cover pointer-events-none">

      <!--
        The translate values are the character's center of visual mass within the image, so that the
        left/top values place that point, rather than the center of the image's bounding box (which
        the rifle skews down and to the right).
      -->
      <img
        id="bountyHunter"
        src="/images/hero/bounty-hunter.webp"
        width="1184"
        height="1012"
        alt="Flutter bounty hunter in power armor, holding a rifle"
        fetchpriority="high"
        class="absolute left-[45%] lg:left-[30%] top-1/2 translate-x-[-46.2%] translate-y-[-49%] w-auto h-auto max-w-[45%] lg:max-w-[34%] max-h-[40%] motion-safe:animate-float"
      >

      <!-- Light projected from the rifle's scope onto the subtitle. Drawn by the script at the end of the page. -->
      <canvas id="scopeBeam" class="absolute inset-0 w-full h-full pointer-events-none mix-blend-screen" aria-hidden="true"></canvas>

      <div class="absolute inset-x-0 top-[65%] px-[24px] text-center lg:left-[51%] lg:right-0 lg:top-1/2 lg:-translate-y-1/2 lg:pl-0 lg:text-left">
        <h1>
          <img
            src="/images/hero/title.webp"
            width="1500"
            height="678"
            alt="Flutter Bounty Hunters"
            fetchpriority="high"
            class="mx-auto lg:mx-0 w-[min(86vw,420px)] lg:w-[min(35vw,760px)] max-w-none h-auto"
          >
        </h1>
        <p class="mt-[8px] lg:mt-[min(1.2vw,26px)]">
          <span id="hologram" class="block relative mx-auto lg:mx-0 lg:ml-[max(-0.956vw,-20.8px)] w-[min(90vw,443px)] lg:w-[min(36.91vw,801.5px)]">
            <img
              src="/images/hero/subtitle-hologram.webp"
              width="1544"
              height="300"
              alt="Squash bugs. Build tools."
              class="hologram-scanlines block w-full max-w-none h-auto"
            >
            <span class="hologram-sweep absolute inset-0" aria-hidden="true"></span>
          </span>
        </p>
      </div>
    </header>

    <!-- Sits below the hero, then sticks to the top of the window. Its height matches the scroll padding in tailwind.css. -->
    <nav id="navbar" aria-label="Main" class="navbar group sticky top-0 z-40 h-[64px]">
      <div class="flex items-center justify-end lg:justify-center px-[24px] h-full">
        <button
          id="navbarToggle"
          type="button"
          aria-controls="navbarMenu"
          aria-expanded="false"
          aria-label="Menu"
          class="lg:hidden flex items-center justify-center -mr-[12px] w-[48px] h-[48px] text-[20px] text-[#8FD8FF] hover:text-white"
        >
          <i class="fa-solid fa-bars group-data-[open]:hidden" aria-hidden="true"></i>
          <i class="fa-solid fa-xmark !hidden group-data-[open]:!inline" aria-hidden="true"></i>
        </button>

        <!-- A row of links on large screens, and a dropdown menu on small screens -->
        <div
          id="navbarMenu"
          class="hidden group-data-[open]:flex absolute inset-x-0 top-full flex-col px-[24px] pt-[8px] pb-[24px] max-h-[calc(100svh-64px)] overflow-y-auto bg-[#07101D] lg:flex lg:relative lg:inset-auto lg:flex-row lg:items-center lg:gap-[12px] lg:p-0 lg:h-full lg:max-h-none lg:overflow-visible lg:bg-transparent"
        >
          <!-- Target brackets that lock onto the link for the section in view, or the link being pointed at -->
          <span id="navbarTarget" class="navbar-target hidden lg:block" aria-hidden="true"></span>

          <a href="#Services" class="navbar-link">Services</a>
          <a href="#HappyClients" class="navbar-link">Happy Clients</a>
          <a href="#OurFunders" class="navbar-link">Our Funders</a>
          <a href="#Packages" class="navbar-link">Packages</a>
          <a href="#OurTeam" class="navbar-link">Our Team</a>
          <a href="#WorkWithUs" class="navbar-link">Work With Us</a>
        </div>
      </div>
    </nav>

    <main>
      <div id="Services" class="services">
        <h2 class="services-title">Services</h2>

        <div class="service">
          <div class="service-text">
            <h3 class="service-title">Package Creation</h3>
            <p class="service-description">Your app needs something that Flutter doesn't do. We'll build and maintain a Pub package that does what you need. See our <a href="#Packages" class="service-link">existing packages</a> for examples.</p>
          </div>
          <img src="/images/services/package-creation.webp" width="1200" height="900" alt="A yellow industrial mech loader standing in front of a staggered stack of armored space containers spray-painted with the Flutter logo inside a dimly lit cargo bay" loading="lazy" class="service-image">
        </div>

        <div class="service">
          <div class="service-text">
            <h3 class="service-title">Bug Squashing</h3>
            <p class="service-description">A Flutter bug is upsetting your customers. We'll fix it, and submit a PR to the Flutter team.</p>
          </div>
          <img src="/images/services/bug-squashing.webp" width="1200" height="900" alt="A xenomorph-style alien stretching out from a dark shadowy gap between two armored Flutter cargo containers, its claws gripping the container corners" loading="lazy" class="service-image">
        </div>

        <div class="service">
          <div class="service-text">
            <h3 class="service-title">Feature Development</h3>
            <p class="service-description">You need Flutter to do something that it doesn't do. No problem. We'll design and build the feature into Flutter, and then submit a PR to the Flutter team.</p>
          </div>
          <img src="/images/services/feature-development.webp" width="1200" height="900" alt="A massive armored Flutter space base with Dash birds flying out of its hangar bay and a glowing blue holographic blueprint of a new wing projected onto an adjacent concrete slab" loading="lazy" class="service-image">
        </div>
      </div>

      <div id="HappyClients" class="clients">
        <h2 class="clients-title">Happy Clients</h2>

        <!-- In the client's brand color, with their photo as the head in their logo -->
        <figure class="client" style="--brand: #3148ff; --brand-light: #4a63ff">
          <div class="client-text">
            <blockquote>
              <p class="client-lead">Matt has been an invaluable partner for Clearful.</p>
              <p>His technical knowledge, API design and implementation skills, and commitment to the open-source community have provided us with best-in-class solutions to our business problems.</p>
              <p>We strongly recommend Matt and Flutter Bounty Hunters and are excited to continue working together.</p>
            </blockquote>
            <figcaption><span class="client-name">Jeffrey Bunn</span>, <a href="https://clearful.com" target="_blank" class="client-company">Clearful</a></figcaption>
          </div>

          <div class="client-mark">
            <svg viewBox="0 0 480 360" aria-hidden="true"><path fill="#fff" d="M72 204C130 204 150 240 175 280 195 312 215 324 240 324 265 324 285 312 305 280 330 240 355 204 408 204 450 204 480 235 480 275 480 320 440 360 395 360L85 360C40 360 0 320 0 275 0 235 30 204 72 204Z"/></svg>
            <img src="/images/clients/clearful_testimonial_jeff.png" width="256" height="256" alt="Jeffrey Bunn">
          </div>
        </figure>
      </div>

      <div id="OurFunders" class="funders border-b-2 border-[#262626]">
        <canvas id="fundersBeams" class="funders-beams" aria-hidden="true"></canvas>
        <img id="fundersHunter" src="/images/funders/bounty-hunter-looking-up.webp" width="1449" height="810" alt="" class="funders-hunter">
        <canvas id="fundersBeamsInFront" class="funders-beams" aria-hidden="true"></canvas>

        <div class="funders-stage">
          <h2 class="funders-title">They keep the lights on</h2>

          <!-- x and y are the center of each funder, within the 1440x1080 layout that's described in tailwind.css -->
          <div class="funders-list">
            <a href="https://bringingfire.com" target="_blank" class="funder" style="--x: 152; --y: 408">
              <span class="funder-logo">
                <img src="/images/funders/bringing-fire_hologram.svg" alt="" class="funder-logo-hologram">
                <img src="/images/funders/bringing-fire_hologram.svg" alt="" class="funder-logo-solid">
              </span>
              Bringing Fire
            </a>
            <a href="https://superlist.com" target="_blank" class="funder" style="--x: 432; --y: 340">
              <span class="funder-logo">
                <img src="/images/funders/superlist_hologram.svg" alt="" class="funder-logo-hologram">
                <img src="/images/funders/superlist_hologram.svg" alt="" class="funder-logo-solid">
              </span>
              Superlist
            </a>
            <a href="https://clickup.com" target="_blank" class="funder" style="--x: 720; --y: 318">
              <span class="funder-logo">
                <img src="/images/funders/clickup_hologram.svg" alt="" class="funder-logo-hologram">
                <img src="/images/funders/clickup_hologram.svg" alt="" class="funder-logo-solid">
              </span>
              ClickUp
            </a>
            <a href="https://clearful.com" target="_blank" class="funder" style="--x: 1008; --y: 340">
              <span class="funder-logo">
                <img src="/images/funders/clearful_hologram.svg" alt="" class="funder-logo-hologram">
                <img src="/images/funders/clearful_hologram.svg" alt="" class="funder-logo-solid">
              </span>
              Clearful
            </a>
            <a href="https://reflection.app" target="_blank" class="funder" style="--x: 1288; --y: 408">
              <span class="funder-logo">
                <img src="/images/funders/reflection-app_hologram.svg" alt="" class="funder-logo-hologram">
                <img src="/images/funders/reflection-app_hologram.svg" alt="" class="funder-logo-solid">
              </span>
              Reflection
            </a>
          </div>

          <a href="#WorkWithUs" class="funders-cta">Become a funder</a>
        </div>
      </div>

      <div id="Packages" class="pb-[140px] lg:pb-[180px] text-center border-b-2 border-[#262626]">
        <div class="packages-intro">
          <img src="/images/packages/container-hangar.webp" width="1670" height="1010" alt="The bounty hunter walking out of a colossal armored container with a case of equipment" loading="lazy" class="packages-scene">

          <div class="packages-pitch">
            <h2 class="packages-title"><span>What Flutter </span><span>doesn’t ship, </span><span>we build</span></h2>
            <p class="packages-summary">Some features take months to build and years to maintain. We turn them into open source packages, so your team can install them instead.</p>

            <a href="https://pub.dev/packages/super_editor" target="_blank" class="packages-flagship">
              <span class="packages-flagship-label">Our flagship</span>
              <span class="packages-flagship-name">Super Editor</span>
              <span>The document editing toolkit for Flutter</span>
            </a>
          </div>
        </div>

        <!-- Super Editor: what people can build with it. The screens are painted with HTML, and they're sized in "--u" units. -->
        <section class="super-editor">
          <svg class="hidden" aria-hidden="true">
